# ═══ BUILD CONFIG FOR THE ANDROID APP ════════════════════════════════════════════════════
#
# Loaded by `vite build --mode mobile` (client/package.json -> build:mobile). Vite reads env
# files from the REPO ROOT, not from client/ — see `envDir: '..'` in client/vite.config.js —
# which is why this file lives here next to .env.example rather than beside the code it
# configures.
#
# ── THIS FILE IS COMMITTED, AND MUST STAY SAFE TO COMMIT ─────────────────────────────────
# Everything Vite exposes to the browser is prefixed VITE_, and everything VITE_-prefixed is
# baked into the JavaScript bundle in plaintext. In a web deployment that bundle is served to
# anyone who visits; in this one it is unpacked inside an APK that anybody can download and
# open with `unzip`. There is no such thing as a secret here. API keys, signing material and
# credentials belong in the SERVER's .env (gitignored) and nowhere near this file.
#
# .gitignore covers `.env` and `*.env`. Neither pattern matches `.env.mobile` — `.env` is an
# exact name and `*.env` matches names ENDING in .env — so this file is tracked as intended
# rather than by accident.

# Selects the mobile build target: drops the admin and organization consoles, hides screen
# share, mounts the native shell. See client/src/platform.js.
VITE_PLATFORM=mobile

# ── THE ONE SETTING THAT MUST BE RIGHT ───────────────────────────────────────────────────
# On the web there is no API URL to configure: the SPA and the API are the same origin (one
# container, see the Dockerfile), so api.js falls back to window.location.origin and the
# right answer follows the deployment around.
#
# In the app that fallback is actively wrong. The WebView serves the bundle from its own
# assets, so window.location.origin is `https://localhost` — the phone itself. Unset, every
# request and every WebSocket would be aimed at a server that does not exist on the device,
# and the app would fail to sign anyone in with a network error that names localhost.
#
# So it is pinned, and it must be the real public origin. hooks/useEventStream.js derives the
# live WebSocket from this same value (http -> ws), so one setting covers REST and live both.
VITE_API_URL=https://get.zoikostream.com

# Where the app sends someone for the surfaces it deliberately does not carry — the platform
# and organization consoles, and the billing screens inside them (see the HAS_CONSOLES gate
# in client/src/App.jsx). Opened in the device browser, never in the WebView.
VITE_WEB_APP_URL=https://get.zoikostream.com
