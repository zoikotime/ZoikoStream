      "item": [
        {
          "name": "getBootstrap",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bootstrap?page_id=home&page_type=home&locale=en-US",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bootstrap"
              ],
              "query": [
                {
                  "key": "page_id",
                  "value": "home"
                },
                {
                  "key": "page_type",
                  "value": "home"
                },
                {
                  "key": "locale",
                  "value": "en-US"
                }
              ]
            },
            "description": "Bootstrap"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('getBootstrap succeeds', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
