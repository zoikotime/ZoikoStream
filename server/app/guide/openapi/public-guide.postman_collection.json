            "description": "Create Session",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_session_nonce\": \"{{$guid}}\",\n  \"page_context\": {\n    \"page_id\": \"home\",\n    \"page_type\": \"home\",\n    \"path\": \"/\",\n    \"locale\": \"en-US\",\n    \"device_class\": \"desktop\",\n    \"entry_point\": \"launcher\"\n  },\n  \"consent_snapshot\": {\n    \"analytics\": \"unknown\",\n    \"consent_version\": null\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('createSession succeeds', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('sessionId', pm.response.json().session_id);",
