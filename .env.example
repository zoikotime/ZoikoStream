# ===== ZoikoStream — example environment file =====
# Copy to .env and fill in real values. .env is gitignored; NEVER commit real credentials.
# Every value here is a PLACEHOLDER. Blank means "feature disabled / not configured", and
# every subsystem below fails closed rather than inventing a default when it is blank.

# --- Backend (FastAPI) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Anyone holding SECRET_KEY can forge a JWT for any user and role. Generate per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# This email registers/seeds as super_admin.
SUPER_ADMIN_EMAIL=
# Optional: set a known super-admin password instead of a generated one (seed.py).
SUPER_ADMIN_PASSWORD=
# ACCESS_TOKEN_HOURS=24
# REMEMBER_TOKEN_DAYS=30
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173
# Origin used to build Stripe Checkout return URLs server-side (never sent by the browser).
# Must match the origin users actually browse, or a payer returns from Stripe to a different
# origin than their session cookie was issued for. Production: https://get.zoikostream.com
APP_URL=http://localhost:5173

# --- Android app (ZoikoStream-app/) ---
# All three are OPTIONAL. Leave them blank on any deployment that has no Android app; blank is
# a complete answer and nothing degrades.
#
# MOBILE_APP_ORIGINS is the Capacitor WebView's own origin, and it is a SEPARATE setting from
# CORS_ORIGINS on purpose. Production refuses any CORS_ORIGINS entry containing localhost —
# with credentialed requests, a localhost origin on a live API lets any page served from a
# user's own machine call it as them — and that rule must not be softened. The WebView's
# origin genuinely IS https://localhost, but it is not the same risk: it addresses the app's
# own bundle inside its own WebView, no port is bound, and nothing else on the device or the
# network can answer on it. Only the two known Capacitor origins are accepted here; anything
# else refuses to boot in production.
#
# Set this or the app cannot call the API at all — every request is CORS-blocked and nobody
# can sign in.
# MOBILE_APP_ORIGINS=https://localhost

# Android App Links. With both set, GET /.well-known/assetlinks.json publishes the statement
# that makes an emailed ZoikoStream link open the APP instead of Chrome. Get these wrong and
# nothing errors — links simply keep opening in a browser, which is indistinguishable from the
# app not being installed.
#
# ANDROID_CERT_FINGERPRINTS is the SHA-256 of the signing certificate: colon-separated
# uppercase hex, comma-separated for more than one (two are needed during a key rotation, and
# while a locally-signed build and a Play-signed build are both in circulation).
#
# THE ONE THAT CATCHES PEOPLE: under Play App Signing, Google re-signs every upload with its
# own key, so the certificate on a real user's device is GOOGLE's, not your upload keystore's.
# Publishing the upload key's fingerprint verifies perfectly against a locally-built APK and
# fails for every install from the store. Take the value from
# Play Console -> Setup -> App signing -> "App signing key certificate".
# ANDROID_PACKAGE_NAME=com.zoikostream.app
# ANDROID_CERT_FINGERPRINTS=

# --- Frontend (Vite; ONLY VITE_* vars reach the browser) ---
# Never put a secret behind a VITE_ prefix — it is compiled into the JS bundle.
VITE_API_URL=http://127.0.0.1:8000

# --- Email (Resend) ---
RESEND_API_KEY=
MAIL_FROM=ZoikoStream <noreply@example.com>
# Internal inbox the public contact form delivers to. SERVER-SIDE ONLY — the browser posts the
# message and never the destination, so no request can retarget an enquiry. Deliberately not a
# VITE_ variable (anything VITE_ is compiled into the JS bundle). Defaults to
# info@zoikostream.com in config.py if unset.
CONTACT_EMAIL=

# --- LiveKit (streaming) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Recording storage (GCS) ---
GCS_BUCKET=
GCS_CREDENTIALS_PATH=

# --- Redis (blank = single-process fan-out only) ---
# Production is Upstash over TLS, so the scheme must be rediss:// — plain redis:// against
# an Upstash endpoint does not fall back to cleartext, it simply fails to connect and
# surfaces as "Timeout connecting to server" from whatever touched Redis first (usually the
# analytics sampler, ~15s into the first broadcast). Copy the endpoint from the Upstash
# console; it carries the password inline, so treat this whole value as a secret.
#   rediss://default:<password>@<endpoint>.upstash.io:6379
# See the "Redis (Upstash) and Cloud Run" section of SETUP_GUIDE.md.
REDIS_URL=

# Pool + timeout budget. Safe to leave unset — app/config.py's defaults are the reviewed
# values. REDIS_MAX_CONNECTIONS is PER PROCESS, so the number that matters against Upstash's
# per-plan connection cap is (Cloud Run max instances x this). Lower it before raising max
# instances.
# REDIS_MAX_CONNECTIONS=24
# REDIS_CONNECT_TIMEOUT=3.0
# REDIS_SOCKET_TIMEOUT=3.0
# REDIS_RETRIES=3

# ===== Payments =====
# Provider-neutral webhook signing secret (POST /commercial/webhooks/payments).
# Blank => that endpoint returns 503 and refuses every call. It never accepts an unsigned
# payload just because verification is unconfigured.
PAYMENTS_WEBHOOK_SECRET=

# ----- Scheduled commercial maintenance -----
# Deliberately NOT env vars. The maintenance windows and the media-plane switch are stored on
# PlatformSetting rows so Operations can change them without a redeploy, and so an
# unconfigured window fails visibly ("skipped") instead of silently using a default:
#
#   maintenance_windows.stale_payment_hours          how long a payment may sit un-settled
#   maintenance_windows.unmatched_settlement_hours   how long unattributed money may sit
#   streaming_limits.require_media_plane             readiness refuses a commercial event with
#                                                    no LiveKit credentials (default: off)
#
# The jobs are driven by an external scheduler hitting POST /api/commercial/maintenance/run —
# there is no in-process scheduler. See SETUP_GUIDE.md "Scheduled commercial maintenance".

# --- Stripe ---
# TEST MODE ONLY in non-production environments. Use the sk_test_... key from
# https://dashboard.stripe.com/test/apikeys
#
# The application starts fine with these blank. But requesting the Stripe provider while
# STRIPE_SECRET_KEY is blank raises a configuration error — it NEVER falls back to the
# simulated mock provider, because a fake "authorized" against a real order is worse than
# an outage.
STRIPE_SECRET_KEY=
# Publishable key (pk_test_...). NOT a secret — it is designed to be public and can only
# create payment attempts, never read or move money. No VITE_ prefix on purpose: the API
# serves it to the browser at runtime, so rotating it needs no frontend rebuild.
STRIPE_PUBLISHABLE_KEY=
# Stripe's own webhook signing secret (whsec_...), used only by Stripe's endpoint.
# Not required to run the test suite — tests sign with their own throwaway secret.
# For local testing:  stripe listen --forward-to localhost:8000/api/commercial/webhooks/stripe
# That command prints the whsec_... value to paste here.
STRIPE_WEBHOOK_SECRET=

# ── Scheduled billing maintenance (Cloud Scheduler -> Cloud Run, OIDC) ──────────────────
# Drives the subscription plan-change sweep. BOTH must be set or
# POST /api/commercial/maintenance/scheduled-run answers 503 and runs nothing — the default
# is refusal, so an unconfigured deployment never exposes an unauthenticated way to move
# customers between paid plans. Neither is a secret: one is a service-account email, the
# other a public URL. See docs/billing-maintenance-runbook.md.
MAINTENANCE_SCHEDULER_SERVICE_ACCOUNT=
MAINTENANCE_OIDC_AUDIENCE=

# --- Public website assistant: ZoikoStream Guide (server/app/guide) ---
# Separate, anonymous trust domain with its OWN Postgres database. Blank URL or a bad key
# disables the Guide only; the platform keeps running. Apply its schema with:
#   cd server && venv/Scripts/python -m alembic -c guide_alembic.ini upgrade head
# Build/refresh the knowledge index from server/app/guide/knowledge/sources/*.md:
#   cd server && venv/Scripts/python -m app.guide.knowledge.ingest
GUIDE_ENABLED=false
# Created (if the user may CREATE DATABASE), migrated and indexed automatically by
# `python create_tables.py` on every deploy; leave empty to run without the public Guide.
GUIDE_DATABASE_URL=
# Guide test suite database (server/guide_tests). Must differ from GUIDE_DATABASE_URL.
GUIDE_TEST_DATABASE_URL=
# "local" is development only (production refuses it). Key: 32 random bytes, hex or base64:
#   python -c "import secrets; print(secrets.token_hex(32))"
GUIDE_KEY_PROVIDER=local
GUIDE_LOCAL_MASTER_KEY=
# "anthropic" = Claude (GUIDE_LLM_MODEL, default claude-opus-5-5); "mock" is development only.
# Comma-separated = fallback chain, e.g. "anthropic,groq": Claude first, Groq on error/timeout.
# (production refuses it). Claude needs ANTHROPIC_API_KEY.
GUIDE_LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
# "groq" = Groq's OpenAI-compatible API; model defaults to openai/gpt-oss-120b.
GROQ_API_KEY=
# GUIDE_GROQ_MODEL=openai/gpt-oss-120b
# GUIDE_LLM_MODEL=claude-opus-5-5
# GUIDE_LLM_EFFORT=low
# Local embedding model for knowledge retrieval (downloaded on first use, ~130 MB, no key).
# GUIDE_EMBEDDING_PROFILE=fastembed:BAAI/bge-small-en-v1.5
# Leads are delivered through the platform's own public contact flow (POST /api/contact).
GUIDE_CONTACT_ENDPOINT=http://127.0.0.1:8002/api/contact
# HS256 key shared with the viewer page that issues public_event_context_token.
GUIDE_EVENT_CONTEXT_KEY=
# Optional: browser origins allowed to call Guide write routes (defaults to CORS_ORIGINS,APP_URL).
# GUIDE_ALLOWED_ORIGINS=

# ── ZoikoStream Guide, operator edition (server/app/operator_guide, ZST-UX-GUIDE-001) ──────
# The console assistant for signed-in hosts and org admins. Uses the PLATFORM database (its own
# opguide_* tables: `cd server && venv/Scripts/python -m app.operator_guide.schema`).
# Super Admin kill switch: Feature flag "operator_guide" (absent = on). Per-org on/off and
# capability switches live in Guide settings (org admins).
OPGUIDE_ENABLED=true
# "" = follow GUIDE_LLM_PROVIDER; "groq" | "anthropic" | "mock". Uses GROQ_API_KEY / ANTHROPIC_API_KEY.
OPGUIDE_LLM_PROVIDER=
# OPGUIDE_GROQ_MODEL=openai/gpt-oss-120b
# OPGUIDE_ANTHROPIC_MODEL=claude-opus-5-5
# OPGUIDE_CONVERSATION_RETENTION_DAYS=90
# OPGUIDE_AUDIT_RETENTION_DAYS=365
# OPGUIDE_PROPOSAL_TTL_MINUTES=10
# OPGUIDE_MESSAGES_PER_MINUTE=30
# Dedicated database for server/operator_guide_tests (TRUNCATED by the suite; never DATABASE_URL).
OPGUIDE_TEST_DATABASE_URL=
