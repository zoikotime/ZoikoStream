# ===== ZoikoStream — single env file for backend + frontend =====
# Copy to .env at the repo root and fill in real values.

# --- Backend (FastAPI) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
SECRET_KEY=change-me-run: python -c "import secrets; print(secrets.token_urlsafe(48))"

# Super admin — this email registers/seeds as super_admin
SUPER_ADMIN_EMAIL=info@zoikostream.com
# ACCESS_TOKEN_HOURS=24
# REMEMBER_TOKEN_DAYS=30
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# --- Frontend (Vite; only VITE_* vars reach the browser) ---
VITE_API_URL=http://localhost:8000
